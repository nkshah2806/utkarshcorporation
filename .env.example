# ---------------------------------------------------------------------------
# Public Website (frontend) — environment variables
# ---------------------------------------------------------------------------
# Copy to `.env` (or `.env.local`) and fill in values. Only VITE_-prefixed
# variables are exposed to the browser bundle.

# Base URL of the Uttkarsh backend API.
VITE_API_URL=https://uttkarsh-backend.onrender.com

# NOTE: Do NOT put the Google Translate API key here. Translation is proxied
# through the backend (`/api/translate`); the key lives only in the backend.
